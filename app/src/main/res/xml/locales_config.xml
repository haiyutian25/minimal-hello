<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the locales the app supports, so Android 13+ (API 33) lists them
  in the system "per-app language" picker. Ignored harmlessly on lower versions.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-CN" />
</locale-config>
