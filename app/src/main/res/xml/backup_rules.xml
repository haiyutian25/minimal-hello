<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (the pre-API-31 full-backup format; API 31+ is governed by
  data_extraction_rules.xml). The custom_fonts directory is excluded: font
  payloads are large binaries (the CJK presets are ~25 MB each, over the 25 MB
  per-app cloud quota, which would make the whole backup silently fail) and
  are re-obtainable — presets re-download from GitHub Releases with SHA-256
  verification, uploaded fonts are re-imported by the user.
-->
<full-backup-content>
    <exclude domain="file" path="custom_fonts" />
</full-backup-content>
